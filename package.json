{
  "name": "@cycjimmy/hello-vue-lib",
  "type": "module",
  "version": "1.3.1",
  "description": "hello vue lib",
  "author": "cycjimmy <cycjimmy@gmail.com> (https://github.com/cycjimmy)",
  "license": "MIT",
  "homepage": "https://github.com/cycjimmy/hello-vue-lib#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/cycjimmy/hello-vue-lib.git"
  },
  "bugs": {
    "url": "https://github.com/cycjimmy/hello-vue-lib/issues"
  },
  "keywords": [
    "vue",
    "github",
    "package",
    "npm"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "trash dist && vite build",
    "build:deployment": "vite build --mode deployment",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "node tasks/checkTypes.ts",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:style": "stylelint \"src/**/*.{css,scss,vue}\"",
    "lint:style:fix": "stylelint \"src/**/*.{css,scss,vue}\" --fix",
    "package": "trash .release && npm run build && node tasks/copyFiles.ts && node tasks/handlePackageJson.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@cycjimmy/config-lib": "^3.2.2",
    "@microsoft/api-extractor": "^7.60.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/language-core": "^3.3.14",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "fs-extra": "^11.4.1",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "postcss-html": "^2.0.1",
    "sass": "^1.108.2",
    "stylelint": "^18.0.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "trash-cli": "^7.2.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "stylelint-order": "^8.1.3"
  }
}
