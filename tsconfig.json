{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "moduleDetection": "force",
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Task scripts are executed by Node's type stripping, which only supports
    // erasable syntax. This rejects enum/namespace/parameter properties at type
    // check time instead of at runtime.
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  // Listed explicitly: a directory glob would also pull generated output
  // (dist/, .release/, coverage/, .publish/) into the type check.
  "include": [
    "env.d.ts",
    "src",
    "demo",
    "tasks",
    "vite.config.ts",
    "vitest.config.ts",
    "eslint.config.ts",
    "stylelint.config.ts"
  ]
}
